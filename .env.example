# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Omit a variable to use its default. An empty value (VAR=) overrides the default with "".
# (Exception: DECIDER_SHADOW= is meaningful: it turns shadowing off.)

# Roles. The game uses the PRIMARY backend's answers. The SHADOW runs alongside for
# comparison stats. Values: jev | nimble. They must differ.
# Defaults: primary=jev, shadow=nimble.
# Before you have a Jev key, use primary=nimble and a blank shadow:
DECIDER_PRIMARY=nimble
DECIDER_SHADOW=

# Hosted Jev (TypeSafe). Key from https://console.typesafe.ai/keys
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest

# Local Nimble via Ollama (defaults shown)
# NIMBLE_BASE_URL=http://localhost:11434/v1
# NIMBLE_MODEL=nimble

# Misc (defaults shown)
# REQUEST_TIMEOUT_S=30

# Stats database, and the idle time after which a backend's next call is flagged cold (defaults shown)
# STATS_DB_PATH=data/decisions.db
# COLD_AFTER_S=300
