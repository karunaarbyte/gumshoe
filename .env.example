# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Omit a variable to use its default. An empty value (VAR=) overrides the default with "".

# Decision backend: jev | nimble
DECIDER_BACKEND=nimble

# Hosted Jev (TypeSafe)
JEV_API_KEY=
JEV_BASE_URL=
# JEV_MODEL=

# Local Nimble via Ollama (defaults shown)
# NIMBLE_BASE_URL=http://localhost:11434
# NIMBLE_MODEL=nimble

# Misc (defaults decided in Task 1.4)
# DECISION_LOG_PATH=data/decisions.jsonl
# REQUEST_TIMEOUT_S=30
