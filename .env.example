# Copy to .env (in the project root, next to pyproject.toml) and fill in. .env is git-ignored;
# this file is committed. The app reads .env from the project root whatever directory it is
# started from, and resolves relative paths below against the project root too.
# Omit a variable to use its default. An empty value (VAR=) overrides the default with "".
# (Exceptions: DECIDER_SHADOW= turns shadowing off; SAVES_DIR= means the default.)
# Keys the app does not know are ignored (the file may be shared), so a misspelled name is
# silently ignored as well: check spellings against this file.

# Hosted Jev (TypeSafe). Key from https://console.typesafe.ai/keys
# With a key and nothing else set, Jev decides and local Nimble runs beside it as the shadow.
JEV_API_KEY=
# JEV_BASE_URL must be https (plain http only for localhost / 127.0.0.1)
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest

# Shadow run: true (default) = Jev decides and local Nimble runs beside it, recorded only.
# false = Nimble alone decides: no Jev calls, no Jev key needed. Overrides the two roles below.
# SHADOW_RUN=false

# Roles. The game uses the PRIMARY backend's answers; the SHADOW runs alongside, recorded only.
# Values: jev | nimble; they must differ. Defaults: primary=jev, shadow=nimble.
# DECIDER_PRIMARY=nimble on its own means no shadow.
# No Jev key yet? Uncomment both lines to play on Nimble alone:
# DECIDER_PRIMARY=nimble
# DECIDER_SHADOW=

# Local Nimble via Ollama (defaults shown)
# NIMBLE_BASE_URL=http://localhost:11434/v1
# NIMBLE_MODEL=nimble

# Misc (defaults shown)
# REQUEST_TIMEOUT_S=30

# Stats database, and the idle time after which a backend's next call is flagged cold (defaults shown)
# STATS_DB_PATH=data/decisions.db
# COLD_AFTER_S=300

# The agent loop: the persona model on Ollama and its gates (defaults shown)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# PERSONA_MODEL_DEFAULT=ministral-3:14b
# PERSONA_MODEL_DRAMATIC=gemma4:12b
# DRAMATIC_FROM=2.5
# CONFIDENCE_GATE=0.6
# CONFIRM_GATE=0.8
# MAX_REDRAFTS=3
# LLM_TIMEOUT_S=60

# Saves (default shown; relative to the project root). GUMSHOE_SAVES is the older name and
# still works; SAVES_DIR wins when both are set.
# SAVES_DIR=saves

# Prices in US dollars per million tokens, for the stats' cost columns (default 0 = free)
# JEV_USD_PER_MTOK_IN=0
# JEV_USD_PER_MTOK_OUT=0
# NIMBLE_USD_PER_MTOK_IN=0
# NIMBLE_USD_PER_MTOK_OUT=0

# The HTTP API (defaults shown). CORS_ORIGINS is a comma-separated list of explicit browser
# origins such as http://localhost:5173 (never *); empty means no cross-origin access.
# CORS_ORIGINS=
# API_HOST=127.0.0.1
# API_PORT=8000
# TURN_TIMEOUT_S=120
# MAX_BODY_BYTES=16384
# No authentication: keep API_HOST on the loopback address.

# Public mode (when the API is reachable from the internet, behind a tunnel). PUBLIC_ORIGIN is the
# site's own https origin: it turns on the Secure __Host- cookie and the strict Origin check.
# SESSION_SECRET (32+ characters, required with PUBLIC_ORIGIN) signs session cookies and keys save
# ownership; change it and every session and save owner is lost. Without PUBLIC_ORIGIN a random
# secret is made at start (sessions reset on restart).
# PUBLIC_ORIGIN=
# SESSION_SECRET=

# Limits (defaults shown; 0 = unlimited). Per session (the cookie), per client IP, and global.
# SESSION_GAMES_OPEN=3
# SESSION_GAMES_PER_HOUR=20
# SESSION_TURNS_PER_MINUTE=30
# SESSION_TURNS_IN_FLIGHT=1
# IP_NEW_SESSIONS_PER_HOUR=10
# IP_REQUESTS_PER_MINUTE=300
# IP_TURNS_PER_MINUTE=60
# IP_TURNS_IN_FLIGHT=2
# IP_GAMES_OPEN=6
# MAX_GAMES=              # unset: 1000 locally, 200 in public mode
# MAX_PARALLEL_TURNS=2    # turns processed at once (the Ollama bottleneck)
# TURN_QUEUE_SIZE=4       # turns allowed to wait for a place; more are refused with 429 busy
# TURN_QUEUE_WAIT_S=20    # seconds a queued turn waits before giving up (busy ending)
# SHADOW_PARALLEL=1       # background Nimble shadow calls at once; extra ones are skipped
# LIMITER_MAX_KEYS=20000  # (minimum 100) keys each rate-limit table keeps
# Expiry and saves (defaults shown). An idle game is closed after GAME_IDLE_MINUTES (its owner then
# gets 410 cold); saves older than SAVE_RETENTION_DAYS are deleted (hourly and at startup).
# SESSION_SAVES / IP_SAVES cap the saves one session / one client IP may hold (429 quota).
# 0 = off for the two expiry settings (never close, keep forever); 0 = unlimited for the two caps.
# GAME_IDLE_MINUTES=30
# SAVE_RETENTION_DAYS=30
# SESSION_SAVES=10
# IP_SAVES=20
# Notes on the rate limits:
# - IP_REQUESTS_PER_MINUTE counts every API request from the IP, including GET /api/health.
# - IP_NEW_SESSIONS_PER_HOUR counts attempts to start a session, not only the ones that succeed.
# - A rate-limit table holds at most LIMITER_MAX_KEYS keys. Only expired keys are evicted; when
#   every key is live the table fails closed: new clients get 429 until entries expire.
# - 0 = unlimited for every number above (MAX_GAMES is unset, not 0, for its default).
# TRUST_PROXY=true only behind exactly one trusted proxy such as a Cloudflare Tunnel: the client
# IP is then read from X-Forwarded-For. Leave false otherwise (the header would be spoofable).
# TRUST_PROXY=false
